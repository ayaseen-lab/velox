PORT=3001
DAILY_LIMIT=490

# Account 1 — Primary sender
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Ahmad Yaseen
SMTP_ACCOUNT_1_USER=your-email@gmail.com
SMTP_ACCOUNT_1_PASS=your-app-password
SMTP_ACCOUNT_1_DAILY_LIMIT=490
SMTP_ACCOUNT_1_DELAY_MS=5000

# Account 2 — Protected (lower limit, slower sends)
SMTP_ACCOUNT_2_USER=your-second-email@gmail.com
SMTP_ACCOUNT_2_PASS=your-app-password
SMTP_ACCOUNT_2_FROM_NAME=Ahmad Yaseen
SMTP_ACCOUNT_2_DAILY_LIMIT=490
SMTP_ACCOUNT_2_DELAY_MS=8000

# Account 3 — Hostinger (required: USER, PASS, HOST, PORT)
SMTP_ACCOUNT_3_USER=you@yourdomain.com
SMTP_ACCOUNT_3_PASS=your-mailbox-password
SMTP_ACCOUNT_3_HOST=smtp.hostinger.com
SMTP_ACCOUNT_3_PORT=465
SMTP_ACCOUNT_3_FROM_NAME=Your Name

# Account 4 — Hostinger
SMTP_ACCOUNT_4_USER=ahmad@yourdomain.com
SMTP_ACCOUNT_4_PASS=your-mailbox-password
SMTP_ACCOUNT_4_HOST=smtp.hostinger.com
SMTP_ACCOUNT_4_PORT=465
SMTP_ACCOUNT_4_FROM_NAME=Ahmad

# Account 5 — Hostinger
SMTP_ACCOUNT_5_USER=outreach@yourdomain.com
SMTP_ACCOUNT_5_PASS=your-mailbox-password
SMTP_ACCOUNT_5_HOST=smtp.hostinger.com
SMTP_ACCOUNT_5_PORT=465
SMTP_ACCOUNT_5_FROM_NAME=Outreach

SEND_DELAY_MS=5000
TEST_EMAIL=test@example.com
MAX_RETRIES=3

# Dashboard login (use the same values on Vercel and Railway)
DASHBOARD_PASSWORD=8888
AUTH_SECRET=change-me-to-a-long-random-string

# Supabase Auth (optional — enables email + password login via Supabase)
# Project dashboard: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
REACHLY_ADMIN_EMAIL=reachly@xynovix.com
